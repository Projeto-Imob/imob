# Variáveis do app. Copie para .env.local e preencha só no seu computador.
# Regra 17: nunca versione .env*, exceto este arquivo. Nenhum segredo usa o prefixo NEXT_PUBLIC_.

# Fonte de dados: "local" (padrão, LocalStorage e modo demo) ou "postgres". Não é segredo.
NEXT_PUBLIC_DATA_SOURCE=local

# --- Banco (modo postgres) — só no servidor ---
# Conexão do papel app_user (sem BYPASSRLS). Ex.: postgres://app_user:<senha>@localhost:5432/imob
# DATABASE_URL=

# --- Autenticação (Better Auth) — só no servidor ---
# Segredo longo e aleatório para assinar sessões.
# BETTER_AUTH_SECRET=
# URL pública do app. Ex.: http://localhost:3000
# BETTER_AUTH_URL=

# --- Armazenamento S3 compatível (Cloudflare R2 ou MinIO) — só no servidor ---
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- IA (desligada até a escolha do modelo, C2; flag ia_motivo) — só no servidor ---
# ANTHROPIC_API_KEY=

# --- Ferramentas locais do framework AIOX (opcionais) ---
# GITHUB_TOKEN=
